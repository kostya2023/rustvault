
upstream rustvault_backend {
    server backend:8080;
    keepalive 32;
}

server {
    listen ${PORT} default_server;
    server_name ${SERVER_NAME};

    set $always_redirect ${NGINX_ALWAYS_TLS_REDIRECT};

    client_max_body_size 100m;

    if ($always_redirect = on) {
        return 301 https://$host$request_uri;
    }

    location = /healthz {
        access_log off;

        proxy_pass http://rustvault_backend/v1/healthz;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header Connection "";
    }

    location ^~ /v1/ {
        proxy_pass http://rustvault_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header User-Agent $http_user_agent;
        proxy_set_header Connection "";

        # Streaming / SSE
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;

        add_header X-Accel-Buffering no always;
    }

    location / {
        return 404;
    }
}

server {
    listen ${SSL_PORT} ssl;
    server_name ${SERVER_NAME};

    ssl_certificate ${SSL_CERT_FILE};
    ssl_certificate_key ${SSL_CERT_KEY_FILE};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 100m;

    location = /healthz {
        access_log off;

        proxy_pass http://rustvault_backend/v1/healthz;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header Connection "";
    }

    location ^~ /v1/ {
        proxy_pass http://rustvault_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header User-Agent $http_user_agent;
        proxy_set_header Connection "";

        # Streaming / SSE
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;

        add_header X-Accel-Buffering no always;
    }

    location / {
        return 404;
    }
}
